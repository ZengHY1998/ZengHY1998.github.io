---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';


import ZengHY from '../assets/ZengHY.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-你的测量ID"></script>
		<script is:inline>
  			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-你的测量ID');
		</script>
	</head>
	<body>
		<Header />
		<main>
			<div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-start max-w-4xl mx-auto">
				<div class="md:col-span-2 flex justify-center w-full">
					<Image src={ZengHY} alt="我的个人头像" width={240} height={400} class="w-full h-auto p-4 bg-slate-50 rounded-xl border border-slate-100 shadow-sm object-cover"/>
				</div>
				<div class="md:col-span-3 grid grid-cols-1 gap-1 w-full">
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>Name:</strong><span class="text-slate-500">曾的很难喵</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>Age:</strong><span class="text-slate-500">7 Month</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>Graduate:</strong><span class="text-slate-500">筑波大学/重庆邮电大学</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>Major:</strong><span class="text-slate-500">SiC界面缺陷研究</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>Work:</strong><span class="text-slate-500">模拟IC开发工程师</span></p>					
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>Work position:</strong><span class="text-slate-500">模拟IC开发工程师</span></p>					
				</div>
			</div>

		</main>
		<Footer/>
	</body>
</html>
