---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';


import ZengHY from '../assets/ZengHY.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-你的测量ID"></script>
		<script is:inline>
  			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-你的测量ID');
		</script>
	</head>
	<body>
		<Header />
		<main>
			<div class="Base-Information">
				<Image src={ZengHY} alt="我的个人头像" width={300} height={500} class="rounded-full shadow-lg" />
			</div>
		</main>
		<Footer/>
	</body>
</html>
