---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';


import ZengHY from '../assets/ZengHY.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-你的测量ID"></script>
		<script is:inline>
  			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-你的测量ID');
		</script>
	</head>
	<body>
		<Header />
		<main>
			<div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-start max-w-4xl mx-auto">
				<div class="md:col-span-2 flex flex-col items-center w-full h-auto p-2 bg-slate-50 rounded-xl border border-slate-100 shadow-sm object-cover">
					<Image src={ZengHY} alt="我的个人头像" width={240} height={400}/>
					<p class="mt-4 text-center text-xl font-bold text-slate-800 tracking-wide">喵喵Giao教主</p>
				</div>
				<div class="md:col-span-3 grid grid-cols-1 gap-1 w-full">
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>铲屎官:</strong><span class="text-slate-500"> 曾的很难喵</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>芳龄:</strong><span class="text-slate-500">27岁</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>出身:</strong><span class="text-slate-500"> 筑波大学/重庆邮电大学</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>副副业:</strong><span class="text-slate-500"> SiC界面缺陷研究</span></p>				
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>副业Title:</strong><span class="text-slate-500"> 模拟IC开发工程师</span></p>
					<p class="p-2 bg-slate-50 rounded-xl border border-slate-100 hover:shadow-sm transition-shadow text-2xl"><strong>副业内容:</strong><span class="text-slate-500"> IPD(Intelligent Power Device)高边回路开发:Charge-Pump、Gate Driver、IDLE Controller、V-ground</span></p>					
				</div>
			</div>

		</main>
		<Footer/>
	</body>
</html>
